    def popular_combobox_produtos_mestre(self):
        """Busca os produtos do Catálogo Mestre e preenche o combobox e o mapa."""
        try:
            produtos = database.listar_produtos_estoque()
            self.mapa_produtos_mestre.clear()
            nomes_produtos = []
            for p in produtos:
                nome_display = f"{p.NomeProduto} (ID: {p.ProdutoID})"
                nomes_produtos.append(nome_display)
                self.mapa_produtos_mestre[nome_display] = p.ProdutoID
            
            self.combo_produtos_mestre['values'] = nomes_produtos
        except Exception as e:
            logger.error(f"Erro ao carregar produtos mestre no combobox: {e}", exc_info=True)

    def abrir_seletor_pasta_xml(self):
        """Abre o seletor de pastas e inicia o processamento dos XMLs."""
        pasta_selecionada = filedialog.askdirectory(title="Selecione a pasta contendo os XMLs")
        if not pasta_selecionada:
            return
            
        # Limpa as listas da tela e da memória
        for i in self.tree_vincular.get_children(): self.tree_vincular.delete(i)
        for i in self.tree_prontos.get_children(): self.tree_prontos.delete(i)
        self.itens_xml_nao_vinculados.clear()
        self.dados_notas_processadas.clear()

        try:
            self.processar_arquivos_xml(pasta_selecionada)
            messagebox.showinfo("Processamento Concluído", 
                                f"Leitura de XMLs concluída.\n\n"
                                f"- {len(self.itens_xml_nao_vinculados)} itens precisam de vinculação (Passo 2).\n"
                                f"- {len(self.dados_notas_processadas)} NFs foram processadas com sucesso e estão prontas para salvar (Passo 3).",
                                parent=self.root)
        except Exception as e:
            logger.error(f"Erro GERAL ao processar pasta XML: {e}", exc_info=True)
            messagebox.showerror("Erro Crítico no Processamento", f"Ocorreu um erro ao ler os arquivos:\n{e}", parent=self.root)
            
    def ler_xml_nota_fiscal(self, caminho_arquivo_xml):
        """Lê um único arquivo XML e extrai os dados do cabeçalho e dos itens."""
        try:
            parser = ET.XMLParser(remove_blank_text=True)
            tree = ET.parse(caminho_arquivo_xml, parser)
            root = tree.getroot()
            
            # Namespace (essencial para XML de NF-e)
            ns = {'nfe': 'http://www.portalfiscal.inf.br/nfe'}
            
            # --- Dados do Cabeçalho ---
            ide = root.find('.//nfe:ide', ns)
            emit = root.find('.//nfe:emit', ns)
            total = root.find('.//nfe:total/nfe:ICMSTot', ns)
            
            dados_nf = {
                'NumeroNF': ide.find('nfe:nNF', ns).text,
                'DataEmissao': ide.find('nfe:dhEmi', ns).text.split('T')[0], # Pega só AAAA-MM-DD
                'ValorTotalNF': float(total.find('nfe:vNF', ns).text),
                'FornecedorCNPJ': emit.find('nfe:CNPJ', ns).text,
                'FornecedorNome': emit.find('nfe:xNome', ns).text
            }
            
            # --- Dados dos Itens ---
            itens = []
            produtos_xml = root.findall('.//nfe:det', ns)
            for prod in produtos_xml:
                item_data = prod.find('nfe:prod', ns)
                itens.append({
                    'DescricaoXML': item_data.find('nfe:xProd', ns).text,
                    'Quantidade': float(item_data.find('nfe:qCom', ns).text),
                    'PrecoCustoUnitario': float(item_data.find('nfe:vUnCom', ns).text)
                })
                
            return dados_nf, itens
            
        except Exception as e:
            logger.error(f"Erro ao ler o arquivo XML '{caminho_arquivo_xml}': {e}", exc_info=True)
            raise Exception(f"Falha ao ler o arquivo: {os.path.basename(caminho_arquivo_xml)}\n{e}")

    def processar_arquivos_xml(self, pasta_selecionada):
        """Itera sobre os arquivos XML em uma pasta e os processa."""
        arquivos_xml = [os.path.join(pasta_selecionada, f) for f in os.listdir(pasta_selecionada) if f.lower().endswith('.xml')]
        
        for caminho_xml in arquivos_xml:
            try:
                cabecalho_nf, itens_nf = self.ler_xml_nota_fiscal(caminho_xml)
                
                # --- Lógica de Fornecedor ---
                cnpj = cabecalho_nf['FornecedorCNPJ']
                nome = cabecalho_nf['FornecedorNome']
                
                fornecedor_id = database.buscar_fornecedor_por_cnpj(cnpj)
                if not fornecedor_id:
                    # Se não existe, cria e atualiza a lista na Aba 2
                    database.criar_fornecedor(cnpj, nome)
                    fornecedor_id = database.buscar_fornecedor_por_cnpj(cnpj)
                    self.atualizar_lista_fornecedores() # Atualiza a GUI
                
                # Adiciona o FornecedorID ao cabeçalho para salvar depois
                cabecalho_nf['FornecedorID'] = fornecedor_id
                
                itens_vinculados_para_salvar = []
                
                # --- Lógica de Vinculação (DE/PARA) ---
                for item in itens_nf:
                    desc_xml = item['DescricaoXML']
                    vinculo_existente = database.buscar_vinculo_produto_fornecedor(fornecedor_id, desc_xml)
                    
                    if vinculo_existente:
                        # Se já está vinculado, preparamos para salvar
                        produto_fornecedor_id, produto_mestre_id = vinculo_existente
                        
                        item_pronto = item.copy() # Copia os dados do XML (Qtd, Custo)
                        item_pronto['ProdutoFornecedorID'] = produto_fornecedor_id
                        
                        itens_vinculados_para_salvar.append(item_pronto)
                        
                        # Adiciona na árvore de "Prontos para Salvar" (GUI)
                        nome_mestre = [k for k, v in self.mapa_produtos_mestre.items() if v == produto_mestre_id][0]
                        custo_total = item['Quantidade'] * item['PrecoCustoUnitario']
                        
                        self.tree_prontos.insert("", "end", values=(
                            cabecalho_nf['NumeroNF'], nome, nome_mestre, 
                            f"{item['Quantidade']:.2f}", f"{item['PrecoCustoUnitario']:.4f}", f"{custo_total:.2f}"
                        ))
                    
                    else:
                        # Se NÃO está vinculado, adiciona na lista de pendentes
                        item_pendente = {
                            'FornecedorID': fornecedor_id,
                            'FornecedorNome': nome,
                            'DescricaoXML': desc_xml
                        }
                        self.itens_xml_nao_vinculados.append(item_pendente)
                        self.tree_vincular.insert("", "end", values=(
                            nome, desc_xml, "--- PENDENTE ---"
                        ))

                # Se a nota teve itens (mesmo que alguns pendentes), ela é processada
                if itens_nf:
                    # Armazena em memória para salvar depois
                    self.dados_notas_processadas.append({
                        'cabecalho': cabecalho_nf,
                        'itens_vinculados': itens_vinculados_para_salvar
                    })
                    
            except Exception as e:
                logger.warning(f"Falha ao processar o arquivo {caminho_xml}: {e}")
                # Opcional: mostrar um aviso ao usuário
                # messagebox.showwarning("Aviso de Arquivo", f"Não foi possível processar o arquivo:\n{os.path.basename(caminho_xml)}\n\n{e}", parent=self.root)

    def vincular_produto_selecionado(self):
        """Cria o vínculo DE/PARA entre o item do XML e o Produto Mestre."""
        selecionado_tree = self.tree_vincular.focus()
        produto_mestre_selecionado = self.combo_produtos_mestre.get()
        
        if not selecionado_tree:
            messagebox.showwarning("Aviso", "Selecione um item pendente na lista 'Itens Pendentes' (Passo 2).", parent=self.root)
            return
        
        if not produto_mestre_selecionado:
            messagebox.showwarning("Aviso", "Selecione um 'Produto Mestre' no menu dropdown para vincular.", parent=self.root)
            return

        # Pega o item correspondente da nossa lista em memória
        item_pendente = self.itens_xml_nao_vinculados[self.tree_vincular.index(selecionado_tree)]
        
        produto_mestre_id = self.mapa_produtos_mestre[produto_mestre_selecionado]
        
        try:
            database.criar_vinculo_produto_fornecedor(
                produto_mestre_id,
                item_pendente['FornecedorID'],
                item_pendente['DescricaoXML']
            )
            
            # Atualiza a GUI
            self.tree_vincular.item(selecionado_tree, values=(
                item_pendente['FornecedorNome'],
                item_pendente['DescricaoXML'],
                produto_mestre_selecionado # Mostra o nome do produto vinculado
            ))
            
            # Remove da lista de pendentes (opcional, ou apenas atualiza a cor)
            # Por simplicidade, vamos apenas atualizar o texto.
            
            messagebox.showinfo("Sucesso", "Vínculo criado! Na próxima importação, este item será automático.", parent=self.root)
            
        except Exception as e:
            logger.error(f"Erro ao criar vínculo: {e}", exc_info=True)
            messagebox.showerror("Erro de Banco", f"Não foi possível criar o vínculo.\n{e}", parent=self.root)

    def salvar_notas_processadas(self):
        """Salva todas as notas e itens que já estão vinculados no banco de dados."""
        if not self.dados_notas_processadas:
            messagebox.showwarning("Aviso", "Nenhuma nota fiscal foi processada ou não há itens vinculados para salvar.", parent=self.root)
            return
            
        if any(self.itens_xml_nao_vinculados):
             if not messagebox.askyesno("Aviso", "Você ainda possui itens pendentes de vinculação (na lista do Passo 2).\n\n"
                                     "Deseja salvar assim mesmo? (Apenas os itens já vinculados serão salvos)", parent=self.root):
                return

        sucessos = 0
        falhas = 0
        
        for nf in self.dados_notas_processadas:
            cabecalho = nf['cabecalho']
            itens_para_salvar = nf['itens_vinculados']
            
            if not itens_para_salvar:
                logger.warning(f"Pulando NF {cabecalho['NumeroNF']} pois não possui itens vinculados prontos para salvar.")
                continue
            
            try:
                sucesso_db, msg_db = database.salvar_nota_fiscal_completa(cabecalho, itens_para_salvar)
                if sucesso_db:
                    sucessos += 1
                else:
                    falhas += 1
                    logger.error(f"Falha ao salvar NF {cabecalho['NumeroNF']} no banco: {msg_db}")
            except Exception as e:
                falhas += 1
                logger.error(f"Erro crítico ao tentar salvar NF {cabecalho['NumeroNF']}: {e}", exc_info=True)

        messagebox.showinfo("Processamento Concluído", 
                            f"Processo de salvamento finalizado.\n\n"
                            f"Notas Salvas com Sucesso: {sucessos}\n"
                            f"Notas que Falharam: {falhas}",
                            parent=self.root)
        
        # Limpa tudo após salvar
        for i in self.tree_vincular.get_children(): self.tree_vincular.delete(i)
        for i in self.tree_prontos.get_children(): self.tree_prontos.delete(i)
        self.itens_xml_nao_vinculados.clear()
        self.dados_notas_processadas.clear()

